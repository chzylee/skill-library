# ---- OS / editor cruft ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---- Secrets & local environment ----
# Never commit real credentials; commit .env.example instead.
.env
.env.*
!.env.example
*.pem
*.key
!**/*.pub

# ---- Claude Code local state ----
# .claude/settings.json is shared and tracked; *.local.json is per-machine.
.claude/settings.local.json
.claude/*.local.json

# ---- gstack runtime output (logs, daemon state) ----
.gstack/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---- Logs, temp, and scratch ----
*.log
tmp/
temp/
scratch/
*.tmp
*.bak
*.orig
*.rej

# NOTE: dist/ is intentionally NOT ignored — the packaged *.skill bundles
# in dist/ are committed release artifacts for this library.
